# Salin berkas ini menjadi ".env" lalu isi nilainya.
# JANGAN membagikan .env — isinya setara kunci untuk mengendalikan bot Anda.
#
# Cara mendapatkannya ada di README.md bagian "Notifikasi Telegram".
# TELEGRAM_CHAT_ID boleh berisi beberapa tujuan yang dipisah koma.
# Id grup dan channel selalu negatif, biasanya diawali -100.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
